{
	"name": "@directus-labs/seo-plugin",
	"type": "module",
	"version": "1.2.1",
	"description": "SEO plugin for Directus",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/directus-labs/extensions.git",
		"directory": "packages/seo-plugin"
	},
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle"
	],
	"icon": "extension",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "interface",
				"name": "seo-interface",
				"source": "src/seo-interface/index.ts"
			},
			{
				"type": "display",
				"name": "seo-display",
				"source": "src/seo-display/index.ts"
			}
		],
		"host": ">=10.10.0 <13"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"add": "directus-extension add",
		"validate": "directus-extension validate",
		"test": "vitest run"
	},
	"dependencies": {
		"@directus/format-title": "^12.0.0",
		"micromustache": "^8.0.3",
		"vue-i18n": "^10.0.5"
	},
	"devDependencies": {
		"@directus-labs/utils": "workspace:*",
		"@directus/extensions-sdk": "18.1.0",
		"jsdom": "^26.1.0",
		"sass": "^1.84.0",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4",
		"vue": "^3.5.13"
	}
}
