	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"test": "vitest run",
		"validate": "vue-tsc --noEmit"
	},
	"peerDependencies": {
		"zod": "4.1.12"
	},
	"dependencies": {
		"@directus/format-title": "^11.0.0",
		"@types/lodash-es": "^4.17.12",
		"@vueuse/core": "^14.4.0",
		"date-fns": "^3.6.0",
		"diacritics": "^1.3.0",
		"lodash-es": "^4.17.21",
		"reka-ui": "2.8.2",
		"sass": "^1.77.8",
		"vue": "^3.5.13",
		"vue-i18n": "^11.1.1",
		"vue-router": "^4.5.0"
	},
	"devDependencies": {
		"@directus/constants": "^12.0.0",
