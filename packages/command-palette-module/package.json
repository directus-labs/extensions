{
	"name": "@directus-labs/command-palette-module",
	"type": "module",
	"version": "1.2.0",
	"description": "Command palette module for Directus.",
	"repository": {
		"type": "git",
		"url": "https://github.com/directus-labs/extensions.git",
		"directory": "packages/command-palette-module"
	},
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-module"
	],
	"icon": "extension",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "module",
		"path": "dist/index.js",
