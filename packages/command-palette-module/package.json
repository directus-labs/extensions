		"@vue/test-utils": "^2.4.6",
		"axios": "^1.7.5",
		"happy-dom": "^18.0.1",
		"pinia": "3.0.2",
		"typescript": "^5.5.4",
		"vitest": "^3.2.4",
		"vue-tsc": "^3.1.2"
