{
	"name": "@directus-labs/mock-api-bundle",
	"type": "module",
	"version": "1.0.0",
	"description": "Create mock API endpoints from Studio for testing frontend work against APIs that don't exist yet.",
	"author": "Directus Labs",
	"contributors": [
		{
			"name": "Rob Luton"
		}
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/directus-labs/extensions.git",
		"directory": "packages/mock-api-bundle"
	},
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle"
	],
	"icon": "api",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "module",
				"name": "mock-api",
				"source": "src/app/index.ts"
			},
			{
				"type": "endpoint",
				"name": "mock-api-router",
				"source": "src/api/endpoint.ts"
			},
			{
				"type": "hook",
				"name": "mock-api-setup",
				"source": "src/api/hook.ts"
			}
		],
		"host": ">=12.0.0 <13"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"test": "vitest run",
		"validate": "vue-tsc --noEmit"
	},
	"devDependencies": {
		"@directus/errors": "^3.0.0",
		"@directus/extensions-sdk": "18.1.0",
		"@directus/types": "^18.1.0",
		"@types/express": "^4.17.21",
		"knex": "^3.1.0",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4",
		"vue": "^3.5.13",
		"vue-router": "^4.5.1",
		"vue-tsc": "^3.3.14"
	}
}
